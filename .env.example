# ===== Next.js (.env.local locally / Vercel project env in prod) =====
NEXT_PUBLIC_CONVEX_URL=            # https://<deployment>.convex.cloud (written by `npx convex dev`)
CONVEX_DEPLOYMENT=                 # dev:<name> (written by `npx convex dev`)
NEXT_PUBLIC_SITE_URL=              # https://carigradskidrum.com (canonical origin, no trailing slash)
REVALIDATE_SECRET=                 # shared with Convex env; protects POST /api/revalidate

# ===== Migration script (goes in .env.migration.local — gitignored) =====
# CONVEX_URL=                      # target deployment URL (dev or prod *.convex.cloud)
# MIGRATION_SECRET=                # must equal MIGRATION_SECRET in the Convex deployment env

# ===== Convex deployment env (set via Convex dashboard or `npx convex env set`) =====
# SITE_URL=                        # public site origin used in email links
# RESEND_API_KEY=                  # transactional email (inquiry relay, notifications)
# AUTH_RESEND_KEY=                 # Convex Auth OTP email provider (M2)
# REVALIDATE_SECRET=               # same value as the Next.js one above
# MIGRATION_SECRET=                # guards the migration import action
# JWT_PRIVATE_KEY=                 # generated by `npx @convex-dev/auth` (M2)
# JWKS=                            # generated by `npx @convex-dev/auth` (M2)
# AUTH_GOOGLE_ID=                  # Google OAuth client id (M2)
# AUTH_GOOGLE_SECRET=              # Google OAuth client secret (M2)
# BILLING_PROVIDER=manual          # manual | stripe (flipped in M4)
# STRIPE_SECRET_KEY=               # (M4)
# STRIPE_WEBHOOK_SECRET=           # (M4)
# STRIPE_PRICE_YEARLY=             # (M4) Stripe price id for yearly_365 (EUR 365)
# STRIPE_PRICE_MONTHLY=            # (M4) Stripe price id for monthly_45 (EUR 45)
